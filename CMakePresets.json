{
  "version": 3,
  "configurePresets": [
    {
      "name": "practice",
      "displayName": "Practice (test my code)",
      "binaryDir": "${sourceDir}/build/practice",
      "cacheVariables": { "PRACTICE_USE_SOLUTIONS": "OFF", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "solutions",
      "displayName": "Reference solutions",
      "binaryDir": "${sourceDir}/build/solutions",
      "cacheVariables": { "PRACTICE_USE_SOLUTIONS": "ON", "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "practice", "configurePreset": "practice" },
    { "name": "solutions", "configurePreset": "solutions" }
  ],
  "testPresets": [
    { "name": "practice", "configurePreset": "practice", "output": { "outputOnFailure": true } },
    { "name": "solutions", "configurePreset": "solutions", "output": { "outputOnFailure": true } }
  ]
}
